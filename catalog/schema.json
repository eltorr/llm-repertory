{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eltorr/llm-repertory/blob/main/catalog/schema.json",
  "title": "Engine and model catalog",
  "description": "What the manager can install and run: engines fetched from a git repo at a pinned commit, models fetched from Hugging Face at a pinned revision, and how to prepare, serve and steer each pair. Draft 1.",
  "type": "object",
  "required": [
    "schema_version",
    "engines",
    "models"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "engines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/engine"
      }
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/model"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "argv": {
      "description": "A command as a list of arguments; {placeholders} are filled by the manager (see serve.placeholders).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "license": {
      "type": "object",
      "required": [
        "spdx"
      ],
      "additionalProperties": false,
      "properties": {
        "spdx": {
          "type": "string",
          "description": "SPDX id, or NOASSERTION when part of it has no license"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "step": {
      "description": "One install step. Steps run in order; a step whose 'creates' path exists is skipped.",
      "type": "object",
      "required": [
        "id",
        "title",
        "run"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string"
        },
        "run": {
          "$ref": "#/$defs/argv"
        },
        "creates": {
          "type": "string",
          "description": "Path (relative to the engine folder) that exists once the step has run"
        },
        "needs_root": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "knob": {
      "description": "One placement control the manager can turn. 'live' knobs change while the model serves; the others need a restart.",
      "type": "object",
      "required": [
        "unit",
        "live"
      ],
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "string"
        },
        "arg": {
          "type": "string"
        },
        "endpoint": {
          "type": "string",
          "description": "HTTP route that changes it while serving, e.g. POST /v1/vram"
        },
        "unit": {
          "enum": [
            "bytes",
            "GiB",
            "bool",
            "count",
            "fraction",
            "cpu-list"
          ]
        },
        "live": {
          "type": "boolean"
        },
        "default": {},
        "note": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "env"
          ]
        },
        {
          "required": [
            "arg"
          ]
        },
        {
          "required": [
            "endpoint"
          ]
        }
      ]
    },
    "engine": {
      "type": "object",
      "required": [
        "id",
        "name",
        "license",
        "source",
        "supports",
        "requires",
        "build",
        "serve",
        "placement"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "supports": {
          "description": "What models the engine runs: a model's config.json must name one of these architectures, and its format must be one of these. Curation checks both.",
          "type": "object",
          "required": [
            "architectures",
            "formats"
          ],
          "additionalProperties": false,
          "properties": {
            "architectures": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "config.json architectures, e.g. Qwen4ExpForConditionalGeneration"
            },
            "formats": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "exl3",
                  "gguf",
                  "safetensors"
                ]
              }
            }
          }
        },
        "source": {
          "description": "Where the engine comes from: a git repo at a pinned commit, or this repository itself (self), with its adapter in subdir.",
          "oneOf": [
            {
              "type": "object",
              "required": [
                "git",
                "revision"
              ],
              "additionalProperties": false,
              "properties": {
                "git": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "revision": {
                  "$ref": "#/$defs/sha"
                },
                "subdir": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "self",
                "subdir"
              ],
              "additionalProperties": false,
              "properties": {
                "self": {
                  "const": true
                },
                "subdir": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "requires": {
          "type": "object",
          "required": [
            "platforms",
            "gpu"
          ],
          "additionalProperties": false,
          "properties": {
            "platforms": {
              "type": "array",
              "items": {
                "enum": [
                  "linux-x86_64",
                  "windows-wsl2",
                  "windows-x64",
                  "macos-arm64"
                ]
              }
            },
            "gpu": {
              "type": "object",
              "required": [
                "vendor"
              ],
              "additionalProperties": false,
              "properties": {
                "vendor": {
                  "enum": [
                    "nvidia",
                    "amd",
                    "intel",
                    "apple"
                  ]
                },
                "min_compute_capability": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+$"
                },
                "min_driver": {
                  "type": "string"
                },
                "min_vram_gb": {
                  "type": "number"
                }
              }
            },
            "cuda_toolkit": {
              "type": "string"
            },
            "python": {
              "type": "string",
              "description": "PEP 440 specifier, e.g. >=3.11,<3.13"
            },
            "torch": {
              "type": "string"
            },
            "lock": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        "build": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "serve": {
          "type": "object",
          "required": [
            "command",
            "health",
            "apis",
            "placeholders"
          ],
          "additionalProperties": false,
          "properties": {
            "command": {
              "$ref": "#/$defs/argv"
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "placeholders": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every {name} the command and env use"
            },
            "health": {
              "type": "string",
              "pattern": "^/"
            },
            "ready_line": {
              "type": "string",
              "description": "Log line that means the model has loaded"
            },
            "apis": {
              "type": "array",
              "items": {
                "enum": [
                  "openai-chat",
                  "openai-responses",
                  "openai-completions",
                  "anthropic-messages"
                ]
              }
            },
            "unload": {
              "type": "string",
              "description": "HTTP route that frees the model while the server stays up, if any"
            }
          }
        },
        "placement": {
          "description": "Where experts can live and what moves them: the inputs for sizing and for shifting between tiers.",
          "type": "object",
          "required": [
            "tiers",
            "knobs"
          ],
          "additionalProperties": false,
          "properties": {
            "tiers": {
              "type": "array",
              "items": {
                "enum": [
                  "vram",
                  "ram",
                  "cpu-compute",
                  "nvme",
                  "page-cache"
                ]
              }
            },
            "knobs": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/knob"
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "required": [
        "id",
        "family",
        "quant",
        "label",
        "source",
        "format",
        "bpw",
        "engines",
        "facts",
        "disk",
        "paths",
        "prepare",
        "cpu_execution"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "family": {
          "type": "string",
          "description": "The model's name for clients (what /v1/models lists)"
        },
        "quant": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$",
          "description": "Its short name in the manager: the quant setting, bench run specs, run.sh's QUANT and sizing's key. Its setup step is m plus this without dots (m305)."
        },
        "label": {
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "source": {
          "type": "object",
          "required": [
            "huggingface",
            "revision"
          ],
          "additionalProperties": false,
          "properties": {
            "huggingface": {
              "type": "string",
              "pattern": "^[\\w.-]+/[\\w.-]+$"
            },
            "branch": {
              "type": "string"
            },
            "revision": {
              "$ref": "#/$defs/sha"
            },
            "verify": {
              "enum": [
                "hub-hashes"
              ],
              "default": "hub-hashes"
            }
          }
        },
        "format": {
          "enum": [
            "exl3",
            "gguf",
            "safetensors"
          ]
        },
        "bpw": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "facts": {
          "description": "What sizing needs: the expert layout and the VRAM that isn't experts.",
          "type": "object",
          "required": [
            "experts_per_layer",
            "moe_layers",
            "experts_per_token",
            "expert_bytes",
            "fixed_vram_bytes"
          ],
          "additionalProperties": false,
          "properties": {
            "experts_per_layer": {
              "type": "integer"
            },
            "moe_layers": {
              "type": "integer"
            },
            "experts_per_token": {
              "type": "integer"
            },
            "expert_bytes": {
              "type": "integer",
              "description": "One expert as the VRAM cache holds it"
            },
            "store_record_bytes": {
              "type": "integer",
              "description": "One expert record in the NVMe store"
            },
            "fixed_vram_bytes": {
              "type": "integer",
              "description": "Non-expert VRAM at zero context"
            },
            "kv_bytes_per_token": {
              "type": "object",
              "additionalProperties": {
                "type": "integer"
              },
              "description": "By KV bits"
            },
            "max_context": {
              "type": "integer"
            },
            "mtp": {
              "type": "boolean",
              "description": "The model has an MTP draft layer"
            }
          }
        },
        "disk": {
          "type": "object",
          "required": [
            "download_gb",
            "prepared_gb"
          ],
          "additionalProperties": false,
          "properties": {
            "download_gb": {
              "type": "number"
            },
            "prepared_gb": {
              "type": "number"
            }
          }
        },
        "paths": {
          "type": "object",
          "required": [
            "model_dir"
          ],
          "additionalProperties": false,
          "properties": {
            "model_dir": {
              "type": "string"
            },
            "store": {
              "type": "string"
            }
          }
        },
        "prepare": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "measured": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "machine",
              "decode_tps",
              "report"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "format": "date"
              },
              "machine": {
                "type": "string"
              },
              "engine": {
                "$ref": "#/$defs/id"
              },
              "decode_tps": {
                "type": "number"
              },
              "prefill_tps": {
                "type": "number"
              },
              "report": {
                "type": "string"
              }
            }
          }
        },
        "cpu_execution": {
          "enum": [
            "none",
            "experimental",
            "validated"
          ],
          "description": "Whether the engine's CPU lane can compute this quant's experts: 'none' when no kernel decodes its format, 'experimental' when one exists but is not gated or validated for it"
        },
        "curation": {
          "$ref": "#/$defs/curation"
        }
      }
    },
    "curation": {
      "description": "The last curation run (python -m repertory curate MODEL): curated when the compatibility and regression checks both passed, failed when one failed, untested otherwise (one not run yet, or a reference only recorded). An entry without it predates curation.",
      "type": "object",
      "required": [
        "status",
        "date",
        "checks"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "curated",
            "failed",
            "untested"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "engine_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compat": {
              "$ref": "#/$defs/check"
            },
            "regression": {
              "$ref": "#/$defs/check"
            }
          }
        }
      }
    },
    "machine": {
      "description": "What a check ran on: no host names",
      "type": "object",
      "required": [
        "gpu",
        "vram_gb",
        "ram_gb",
        "platform"
      ],
      "additionalProperties": false,
      "properties": {
        "gpu": {
          "type": [
            "string",
            "null"
          ]
        },
        "vram_gb": {
          "type": [
            "number",
            "null"
          ]
        },
        "ram_gb": {
          "type": [
            "number",
            "null"
          ]
        },
        "platform": {
          "type": "string"
        },
        "os": {
          "type": "string"
        }
      }
    },
    "check": {
      "description": "One check's outcome: ok true (passed), false (failed) or null (not decided: skipped, or a reference only recorded); each item is one thing checked.",
      "type": "object",
      "required": [
        "ok",
        "date",
        "items"
      ],
      "additionalProperties": false,
      "properties": {
        "ok": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "engine_commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "machine": {
          "$ref": "#/$defs/machine"
        },
        "summary": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "ok"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "ok": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "detail": {
                "type": "string"
              }
            }
          }
        },
        "numbers": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  }
}
