#!/bin/bash
# Runs the model server detached from the Repertory manager, so restarting or upgrading the manager doesn't restart
# the model. Where systemd runs (WSL with systemd, most Linux machines) the server is a transient service,
# repertory-backend: fully independent of the shell or wsl.exe that started it, with its RAM limits on the unit.
# Without systemd it runs in its own session. Output goes to .repertory/backend.log.
#
# It starts the engine through its adapter's launcher, engines/exl3_offload/run.sh.
#
#   bin/repertory-backend start [KEY=VALUE ...] -- [run.sh args]   prints "started PID"
#   bin/repertory-backend stop [timeout_s]                         stops ours and any stray model server
#   bin/repertory-backend status                                   "running PID", "stray PIDS" or "stopped"
#   bin/repertory-backend dropcache 1|3                            hand page cache back (WSL; needs root)
#
# Why not setsid everywhere: under WSL, a detached pipeline started through wsl.exe is killed when that wsl.exe
# exits (single processes survive), so the server died writing to its log filter right after the manager started it.
set -u
cd "$(dirname "$(readlink -f "$0")")/.." || exit 1
D=.repertory
mkdir -p "$D"
PIDF=$D/backend.pid
LOG=$D/backend.log
MODEF=$D/backend.mode
UNIT=repertory-backend
RUN=engines/exl3_offload/run.sh
SERVER='[e]ngines/exl3_offload/server\.py'    # how a model server's command line reads (the [e] keeps pgrep off itself)
if [ "$(id -u)" = 0 ]; then SC=(systemctl); SR=(systemd-run); else SC=(systemctl --user); SR=(systemd-run --user); fi
have_systemd() { [ -d /run/systemd/system ] && "${SC[@]}" show-environment >/dev/null 2>&1; }
mode() { cat "$MODEF" 2>/dev/null; }
# model servers run by this user only: another account's process named like one is not ours to wait for or stop
strays() { pgrep -u "$(id -u)" -f "$SERVER" | tr '\n' ' '; }
alive() {
  if [ "$(mode)" = systemd ]; then "${SC[@]}" is-active --quiet "$UNIT"
  else [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null; fi
}

case "${1:-}" in
  start)
    shift
    envs=()
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do envs+=("$1"); shift; done
    [ "${1:-}" = "--" ] && shift
    if alive; then echo "running $(cat "$PIDF")"; exit 3; fi
    if [ -n "$(strays)" ]; then echo "stray $(strays)"; exit 4; fi      # another server would hold the port and GPU
    shown=()     # the dashboard shows this log: leave the manager's key out of it
    for e in "${envs[@]}"; do
      case "$e" in REPERTORY_BACKEND_KEY=*) shown+=("REPERTORY_BACKEND_KEY=...") ;; *) shown+=("$e") ;; esac
    done
    echo "# $(date '+%F %T') start: ${shown[*]} $RUN $*" > "$LOG"
    if have_systemd; then
      "${SC[@]}" reset-failed "$UNIT" >/dev/null 2>&1
      ram=""
      for e in "${envs[@]}"; do case "$e" in RAM_GB=*) ram=${e#RAM_GB=} ;; esac; done
      base=(--quiet --unit="$UNIT" --collect -p WorkingDirectory="$PWD" -p KillMode=control-group
            -p TimeoutStopSec=30 -p StandardOutput=append:"$PWD/$LOG" -p StandardError=append:"$PWD/$LOG"
            -p LimitMEMLOCK=infinity -p LimitNOFILE=1048576)   # pinned host memory; many O_DIRECT readers
      # services start with a bare environment: keep the caller's PATH (WSL's nvidia-smi is in /usr/lib/wsl/lib)
      # and HOME (torch/Triton kernel caches live there)
      setenv=(--setenv=PATH="$PATH" --setenv=HOME="${HOME:-/root}")
      [ -n "${LD_LIBRARY_PATH:-}" ] && setenv+=(--setenv=LD_LIBRARY_PATH="$LD_LIBRARY_PATH")
      for e in "${envs[@]}"; do setenv+=(--setenv="$e"); done
      cmd=(bash -c 'bash "$0" "$@" 2>&1 | python3 -u bin/repertory-timestamp' "$RUN" "$@")
      # RAM limits on the unit itself, so run.sh needn't create a scope (QWEN_IN_SCOPE); retry without them where the
      # memory controller isn't delegated (some --user sessions)
      if [ -n "$ram" ] && "${SR[@]}" "${base[@]}" -p MemoryHigh="$((ram + 16))G" -p MemoryMax="$((ram + 19))G" \
           -p MemorySwapMax=0 "${setenv[@]}" --setenv=QWEN_IN_SCOPE=1 "${cmd[@]}" 2>>"$LOG"; then :
      elif "${SR[@]}" "${base[@]}" "${setenv[@]}" "${cmd[@]}" 2>>"$LOG"; then :
      else echo "systemd-run failed (see $LOG)"; exit 5; fi
      echo systemd > "$MODEF"
      pid=$("${SC[@]}" show -p MainPID --value "$UNIT")
    else
      setsid env "${envs[@]}" bash "$RUN" "$@" >> "$LOG" 2>&1 < /dev/null &
      pid=$!
      echo setsid > "$MODEF"
    fi
    echo "$pid" > "$PIDF"
    echo "started $pid"
    ;;
  stop)
    t=${2:-30}
    if [ "$(mode)" = systemd ]; then
      "${SC[@]}" stop "$UNIT" >/dev/null 2>&1
    elif alive; then
      p=$(cat "$PIDF")
      kill -TERM -- "-$p" 2>/dev/null || kill -TERM "$p" 2>/dev/null
      for _ in $(seq $((t * 2))); do kill -0 "$p" 2>/dev/null || break; sleep 0.5; done
      kill -KILL -- "-$p" 2>/dev/null
    fi
    if [ -n "$(strays)" ]; then
      pkill -TERM -u "$(id -u)" -f "$SERVER"
      for _ in $(seq $((t * 2))); do [ -n "$(strays)" ] || break; sleep 0.5; done
      pkill -KILL -u "$(id -u)" -f "$SERVER"
    fi
    rm -f "$PIDF"
    echo stopped
    ;;
  status)
    if alive; then echo "running $(cat "$PIDF")"
    elif [ -n "$(strays)" ]; then echo "stray $(strays)"
    else echo stopped; fi
    ;;
  dropcache)
    sync
    if [ -w /proc/sys/vm/drop_caches ]; then echo "${2:-1}" > /proc/sys/vm/drop_caches; echo dropped
    else echo "skipped (not root)"; fi
    ;;
  *) echo "usage: $0 {start [K=V ...] -- [run.sh args] | stop [timeout] | status | dropcache 1|3}"; exit 2 ;;
esac
