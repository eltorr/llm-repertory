#!/usr/bin/env python3
"""Prefix each line of the model server's output with the seconds since it started (for .repertory/backend.log)."""
import sys
import time

t0 = time.time()
for raw in sys.stdin.buffer:
    sys.stdout.write("[%6ds] %s" % (time.time() - t0, raw.decode("utf-8", "replace")))
    sys.stdout.flush()
